<UserControl x:Class="TodoApp.RegisterUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Title -->
            <RowDefinition Height="20"/>

            <RowDefinition Height="Auto"/>
            <!-- Full Name Label -->
            <RowDefinition Height="Auto"/>
            <!-- Full Name TextBox -->

            <RowDefinition Height="15"/>

            <RowDefinition Height="Auto"/>
            <!-- Age Label -->
            <RowDefinition Height="Auto"/>
            <!-- Age TextBox -->

            <RowDefinition Height="15"/>

            <RowDefinition Height="Auto"/>
            <!-- Email Label -->
            <RowDefinition Height="Auto"/>
            <!-- Email TextBox -->

            <RowDefinition Height="25"/>

            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Heading -->
        <Label Grid.Row="0"
               Content="Register User"
               FontSize="24"
               FontWeight="Bold"
               HorizontalAlignment="Center"/>

        <!-- Full Name -->
        <Label Grid.Row="2"
               Content="Full Name"/>

        <TextBox Grid.Row="3"
                 x:Name="FullName"
                 Height="35"
                 Padding="5"/>

        <!-- Age -->
        <Label Grid.Row="5"
               Content="Age"/>

        <TextBox Grid.Row="6"
                 x:Name="Age"
                 Height="35"
                 Padding="5"/>

        <!-- Email -->
        <Label Grid.Row="8"
               Content="Email"/>

        <TextBox Grid.Row="9"
                 x:Name="Email"
                 Height="35"
                 Padding="5"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="11"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Register"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="UserAddButton_Clicked"/>

            <Button Content="Clear"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="ClearButton_Clicked"/>


        </StackPanel>

    </Grid>

</UserControl>